# -----------------------------------------------------------------------------
# BlueDXP / Hazalyze - Example Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in your own values.
#
# Windows PowerShell:
#   Copy-Item env.example .env.local
#
# Security:
# - NEVER commit real secrets.
# - Prefer server-side keys (OPENAI_API_KEY / ANTHROPIC_API_KEY).
# -----------------------------------------------------------------------------

# App
NODE_ENV=development
PORT=3002

# -----------------------------------------------------------------------------
# AI Providers (Recommended: server-side)
# -----------------------------------------------------------------------------
# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Development-only options
# -----------------------------------------------------------------------------
# If true, the server will accept API keys sent from the browser in headers
# (x-openai-key / x-anthropic-key). Not recommended for production.
ALLOW_CLIENT_SUPPLIED_AI_KEYS=false

# These are public env vars (sent to browser bundle). Avoid in production.
NEXT_PUBLIC_OPENAI_API_KEY=
NEXT_PUBLIC_ANTHROPIC_API_KEY=

################################################################################
# BlueDXP / Hazalyze - Environment Variables (STARTER TEMPLATE)
#
# What to do (local development):
# 1) Copy `.env.example` (this file) to `.env.local`
# 2) Paste your real keys/values into `.env.local`
# 3) Restart `npm run dev`
#
# Production convention (Next.js):
# - Use `.env.production.local` (NOT `.env.production`)
#
# Full enterprise template:
# - See `env.full.example` for all integrations (247 vars referenced in code)
################################################################################

################################################################################
# REQUIRED (to use AI features)
################################################################################

# Server-side keys (recommended)
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Client-side keys (NOT recommended; exposes keys to the browser bundle)
# If you must use it for quick local testing, uncomment these and paste keys.
# NEXT_PUBLIC_OPENAI_API_KEY=sk-your-openai-api-key-here
# NEXT_PUBLIC_ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

################################################################################
# APP BASICS (recommended)
################################################################################

NODE_ENV=development
PORT=3002
NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3002

# CORS allowlist for server routes/proxies (comma-separated).
# Example: ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002
ALLOWED_ORIGINS=http://localhost:3002

# Optional realtime WS URL used by some services
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:3002

################################################################################
# SECURITY (recommended if you enable auth)
################################################################################

# JWT signing secret (change this for any real deployment)
JWT_SECRET=change_me_in_production

# Optional JWT validation settings (recommended for real deployments)
# JWT_JWKS_URL=
# JWT_ISSUER=
# JWT_AUDIENCE=

################################################################################
# DATABASE (optional - app can run without DB for some features)
################################################################################

# Prefer DATABASE_URL if you have it. Otherwise use the split fields below.
# DATABASE_URL=postgresql://user:password@localhost:5432/hazalyze

# =============================================================================
# STRICT PRODUCTION MODE (Target-2 Bulletproof)
# =============================================================================
# In production, the server will REFUSE TO START unless:
# - DATABASE_URL is set
# - JWT verification is configured (JWT_SECRET or JWT_JWKS_URL)
# - EVENT_STORE_BACKEND is set to "prisma" (durable event store)
#
# Event Store Backend:
# - prisma: persist events/snapshots in Postgres via Prisma models (Event/Snapshot)
EVENT_STORE_BACKEND=prisma
#
# Production rate limiting/caching (required in strict production):
REDIS_URL=redis://localhost:6379
RATE_LIMIT_USER_PER_MINUTE=120
RATE_LIMIT_USER_PER_HOUR=2000
RATE_LIMIT_USER_PER_DAY=20000
#
# Durable object storage (required in strict production):
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=change_me_in_production
MINIO_ROOT_PASSWORD=change_me_in_production
#
# Transportation strict mode (recommended: keep FALSE in production):
# If true, allows mock/simulated transportation features in production (NOT recommended).
ALLOW_TRANSPORT_SIMULATIONS_IN_PROD=false
#
# JWT Verification (choose ONE approach):
# Option A: HS256 (shared secret)
# JWT_SECRET=replace_with_strong_random_secret
#
# Option B: JWKS (recommended for external customers / SSO)
# JWT_JWKS_URL=https://your-idp/.well-known/jwks.json
# JWT_ISSUER=https://your-idp/
# JWT_AUDIENCE=your-api-audience
#
# Security hardening: do NOT allow header-based identity in production unless you operate behind a trusted gateway.
# ALLOW_HEADER_AUTH_IN_PROD=false
# USE_DATABASE=false
# DATABASE_TYPE=postgresql
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=hazalyze
# DATABASE_USER=
# DATABASE_PASSWORD=
# DATABASE_SSL=false

################################################################################
# REDIS (required in strict production)
################################################################################

# REDIS_ENABLED=false
# REDIS_URL=redis://localhost:6379

################################################################################
# NOTES
################################################################################
# - Do NOT commit `.env.local` (this repo already ignores it)
# - If you want “everything enabled”, start from `env.full.example` and fill what you have keys for









