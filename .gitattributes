# ============================================================================
# HAZALYZE PLATFORM - GIT ATTRIBUTES
# Ensures consistent line endings and file handling across platforms
# ============================================================================

# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files you want to always be normalized
*.ts text
*.tsx text
*.js text
*.jsx text
*.json text
*.md text
*.yml text
*.yaml text
*.css text
*.scss text
*.html text
*.xml text
*.txt text
*.sh text
*.bat text
*.ps1 text

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp4 binary
*.mov binary
*.avi binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary

# Mark files that should always have CRLF line endings
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Mark files that should always have LF line endings
*.sh text eol=lf

# Exclude files from Git LFS (if using)
*.md !filter !diff
*.json !filter !diff



