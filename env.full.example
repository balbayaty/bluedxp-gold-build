################################################################################
# BlueDXP / Hazalyze - FULL ENVIRONMENT TEMPLATE (Enterprise)
#
# This file lists ALL environment variables referenced by the codebase
# (auto-extracted: 247 vars).
#
# Use-cases:
# - You want maximum flexibility for integrations (ERP, Gov APIs, carriers, maps, etc.)
# - You want a single place to see "what might be needed"
#
# How to use locally:
# - Copy ONLY what you need into `.env.local`
# - Do not commit `.env.local` (repo ignores it)
#
# Tip:
# - Leave unknown values blank; most integrations only initialize if keys are present.
################################################################################

################################################################################
# CORE APP
################################################################################
NODE_ENV=development
PORT=3002
HOSTNAME=
APP_URL=
API_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_VERCEL_URL=
ALLOWED_ORIGINS=http://localhost:3002
TENANT_ID=
BOOTSTRAP_TENANT_ID=

################################################################################
# SECURITY
################################################################################
JWT_SECRET=
CERTIFICATE_ENCRYPTION_KEY=
JWT_JWKS_URL=
JWT_ISSUER=
JWT_AUDIENCE=

################################################################################
# AI / LLM
################################################################################
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Dev-only (exposes keys to browser bundle; avoid for real deployments)
NEXT_PUBLIC_OPENAI_API_KEY=
NEXT_PUBLIC_ANTHROPIC_API_KEY=

# AI microservice (if used)
AI_SERVICE_HOST=
AI_SERVICE_PORT=

