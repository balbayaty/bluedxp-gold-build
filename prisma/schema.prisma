model billing_credits {
  id                String    @id @default(uuid())
  tenantId          String
  userId            String
  amount            Decimal   @db.Decimal(18, 2)
  currency          String    @default("SAR")
  balance           Decimal   @db.Decimal(18, 2)
  used              Decimal   @default(0) @db.Decimal(18, 2)
