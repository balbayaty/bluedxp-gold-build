// =============================================================================
// EMPLOYEE INVITATIONS & APPROVALS - Company/Team Billing
// =============================================================================

model employee_invitations {
  id                    String    @id @default(uuid())
  tenantId              String
  invitedBy             String    // Admin/manager who sent invitation
  email                 String
  name                  String?
  role                  String    @default("user")
  department            String?
  jobTitle              String?
  status                String    @default("pending") // pending, approved, rejected, expired, accepted
  invitationToken       String    @unique
  tokenExpiresAt        DateTime
  companySubscriptionId String?   // Link to company subscription if approved
  subscriptionId        String?    // Link to billing_subscriptions
  approvedBy            String?
  approvedAt            DateTime?
  rejectedBy            String?
  rejectedAt            DateTime?
  rejectionReason       String?   @db.Text
  acceptedAt            DateTime?
  userId                String?   // User ID after acceptance
  metadata              Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  subscription          billing_subscriptions? @relation("EmployeeInvitations", fields: [subscriptionId], references: [id], onDelete: SetNull)
  user                  User?                 @relation("EmployeeInvitations", fields: [userId], references: [id], onDelete: SetNull)
  approvals              employee_approvals[]

  @@index([tenantId])
  @@index([email])
  @@index([status])
  @@index([invitedBy])
  @@index([invitationToken])
  @@index([tokenExpiresAt])
  @@index([companySubscriptionId])
}

model employee_approvals {
  id                    String    @id @default(uuid())
  tenantId              String
  invitationId          String    @unique
  employeeEmail         String
  employeeName          String?
  requestedBy           String    // Employee who requested
  approverId            String    // Admin who needs to approve
  status                String    @default("pending") // pending, approved, rejected
  approvalLink          String    @unique // Secure link for admin to approve
  approvalToken         String    @unique
  tokenExpiresAt        DateTime
  approvedAt            DateTime?
  rejectedAt            DateTime?
  rejectionReason       String?   @db.Text
  companySubscriptionId String?   // Company subscription to link to
  metadata              Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  invitation            employee_invitations @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([approverId])
  @@index([approvalToken])
  @@index([tokenExpiresAt])
  @@index([companySubscriptionId])
}

// =============================================================================
// PERMISSION AUDIT LOG - Track all permission changes
// =============================================================================
model permission_audit_logs {
  id               String   @id @default(uuid())
  userId           String
  tenantId         String
  action           String // GRANTED, REVOKED, UPDATED, ROLE_CHANGED
  performedBy      String
  previousValue    Json?
