  userAgent        String?
  timestamp        DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([timestamp])
  @@index([performedBy])
}

// =============================================================================
// SYSTEM PARAMETERS - For market data API configurations and settings
// =============================================================================
model SystemParameter {
  id             String   @id @default(uuid())
  parameterKey   String   @unique
  parameterName  String
  category       String // INTEGRATION, NOTIFICATION, SECURITY, etc.
  dataType       String // STRING, NUMBER, BOOLEAN, JSON
  value          String
  defaultValue   String?
  description    String
  isRequired     Boolean  @default(false)
  isEditable     Boolean  @default(true)
  validationRule String?
  lastModified   DateTime @default(now())
  modifiedBy     String
  status         String   @default("ACTIVE")
  tenantId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([parameterKey])
  @@index([category])
  @@index([status])
  @@index([tenantId])
}

// =============================================================================
// GCC COMPLIANCE MODULE - Vehicle Tracking, Bayan, Compliance Certificates
// =============================================================================

model VehicleLocationHistory {
  id             String    @id @default(uuid())
  deviceId       String
  vehicleId      String?
  plateNumber    String?
  shipmentId     String?
  latitude       Decimal   @db.Decimal(10, 7)
  longitude      Decimal   @db.Decimal(10, 7)
  altitude       Decimal?  @db.Decimal(10, 2)
  speed          Decimal   @default(0) @db.Decimal(6, 2)
  heading        Decimal?  @db.Decimal(5, 2)
  source         String // 'IOT' | 'DALEELI' | 'DRIVER' | 'WHATSAPP' | 'TELEGRAM'
  accuracy       Decimal?  @db.Decimal(6, 2)
  batteryLevel   Int?
  signalStrength Int?
  isOnline       Boolean   @default(true)
  eventType      String? // 'NORMAL' | 'STOP' | 'SPEEDING' | 'GEOFENCE_ENTRY' | 'GEOFENCE_EXIT' | 'ANOMALY'
  metadata       Json?
  tenantId       String
  timestamp      DateTime  @default(now())
  createdAt      DateTime  @default(now())
  shipment       Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@index([deviceId])
  @@index([shipmentId])
  @@index([tenantId])
  @@index([timestamp])
  @@index([source])
  @@index([eventType])
}

model BayanWaybill {
  id                 String    @id @default(uuid())
  bayanNumber        String    @unique
  shipmentId         String?
  transporterCR      String // 700# Commercial Registration
  freightForwarderCR String?
  driverNationalId   String
  driverName         String
  vehiclePlate       String
  vehiclePlateType   String?
  trailerPlate       String?
  origin             Json // { city, country, coordinates }
  destination        Json
  cargoDescription   String?
  cargoWeight        Decimal?  @db.Decimal(10, 2)
  cargoType          String? // 'GENERAL' | 'REEFER' | 'HAZMAT' | 'OVERSIZE'
  status             String    @default("DRAFT") // 'DRAFT' | 'ISSUED' | 'IN_TRANSIT' | 'COMPLETED' | 'CANCELLED'
  issuedAt           DateTime?
  validUntil         DateTime?
  daleeliLinked      Boolean   @default(false)
  daleeliDeviceId    String?
  qrCodeData         String?
  metadata           Json?
  tenantId           String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  shipment           Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@index([bayanNumber])
  @@index([shipmentId])
  @@index([tenantId])
  @@index([status])
  @@index([transporterCR])
}

model ComplianceCertificate {
  id                String    @id @default(uuid())
  certificateNumber String    @unique
  shipmentId        String
  type              String // 'PRE_DISPATCH' | 'DELIVERY' | 'ANNUAL'
  status            String    @default("VALID") // 'VALID' | 'EXPIRED' | 'REVOKED'
  validationScore   Int
  stepsCompleted    Int
  totalSteps        Int
  validationResult  Json
  touchpoints       Json?
  bayanNumber       String?
  issuedAt          DateTime  @default(now())
  validUntil        DateTime?
  issuedBy          String
  verificationUrl   String?
  qrCodeData        String?
  metadata          Json?
  tenantId          String
  createdAt         DateTime  @default(now())
  Shipment          Shipment  @relation(fields: [shipmentId], references: [id])

  @@index([shipmentId])
  @@index([tenantId])
  @@index([status])
  @@index([type])
}

model DaleeliApiUsage {
  id             String   @id @default(uuid())
  tenantId       String
  apiType        String // 'LOCATION_PULL' | 'VEHICLE_STATUS' | 'WEIGHT_CHECK' | 'BAYAN_LINK'
  requestCount   Int      @default(1)
  successCount   Int      @default(0)
  failureCount   Int      @default(0)
  vehicleId      String?
  bayanNumber    String?
  responseTimeMs Int?
  billingMonth   String // 'YYYY-MM'
  unitCost       Decimal  @default(0) @db.Decimal(10, 4)
  totalCost      Decimal  @default(0) @db.Decimal(10, 4)
  metadata       Json?
  timestamp      DateTime @default(now())

  @@index([tenantId])
  @@index([billingMonth])
  @@index([apiType])
  @@index([timestamp])
}

model LocationRequest {
  id                String    @id @default(uuid())
  shipmentId        String
  driverId          String?
  driverPhone       String
  driverName        String?
  channel           String // 'WHATSAPP' | 'TELEGRAM' | 'SMS'
  chatId            String?
  requestUrl        String
  status            String    @default("PENDING") // 'PENDING' | 'SENT' | 'DELIVERED' | 'RESPONDED' | 'EXPIRED' | 'FAILED'
  sentAt            DateTime?
  respondedAt       DateTime?
  expiresAt         DateTime?
  responseLocation  Json? // { latitude, longitude, accuracy }
  comparedToDaleeli Boolean   @default(false)
  deviationMeters   Int?
  anomalyDetected   Boolean   @default(false)
  anomalyType       String?
  tenantId          String
  createdAt         DateTime  @default(now())
  shipment          Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([tenantId])
  @@index([status])
  @@index([channel])
}

model TruckBanAlert {
  id               String    @id @default(uuid())
  shipmentId       String
  vehiclePlate     String
  city             String
  alertType        String // 'APPROACHING_BAN_ZONE' | 'IN_BAN_ZONE' | 'PREDICTED_VIOLATION'
  severity         String // 'INFO' | 'WARNING' | 'CRITICAL'
  banStartTime     DateTime?
  banEndTime       DateTime?
  currentLocation  Json
  distanceToZone   Int? // meters
  estimatedArrival DateTime?
  recommendation   String?
  acknowledged     Boolean   @default(false)
  acknowledgedBy   String?
  acknowledgedAt   DateTime?
  resolved         Boolean   @default(false)
  resolvedAt       DateTime?
  tenantId         String
  createdAt        DateTime  @default(now())
  Shipment         Shipment  @relation(fields: [shipmentId], references: [id])

  @@index([shipmentId])
  @@index([tenantId])
  @@index([alertType])
  @@index([severity])
  @@index([city])
}

model GCCComplianceValidation {
  id              String   @id @default(uuid())
  shipmentId      String
  validationType  String // 'PRE_DISPATCH' | 'IN_TRANSIT' | 'DELIVERY'
  overallStatus   String // 'PASSED' | 'FAILED' | 'WARNING'
  canProceed      Boolean
  validationScore Int
  stepsCompleted  Int
  totalSteps      Int
  steps           Json // Array of step results
  recommendations Json?
  blockers        Json?
  validatedAt     DateTime @default(now())
  validatedBy     String?
  tenantId        String
  shipment        Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([tenantId])
  @@index([overallStatus])
  @@index([validatedAt])
}
