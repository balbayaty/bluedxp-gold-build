model billing_revenue_recognition {
  id                 String                 @id @default(uuid())
  tenantId           String
  invoiceId          String
  subscriptionId     String?
  totalRevenue       Decimal                @db.Decimal(18, 2)
  recognizedRevenue  Decimal                @default(0) @db.Decimal(18, 2)
