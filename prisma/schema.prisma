// =============================================================================
// COMPREHENSIVE BILLING SYSTEM - Inspired by OpenAI, Claude, Stripe, Vercel
// =============================================================================

model billing_subscriptions {
  id                 String                        @id @default(uuid())
  tenantId           String
  userId             String
  planId             String
  planName           String
  status             String                        @default("active") // active, trialing, past_due, canceled, unpaid, paused, suspended
  billingCycle       String                        @default("monthly") // monthly, quarterly, annual, custom
  currentPeriodStart DateTime                      @default(now())
  currentPeriodEnd   DateTime
  trialStart         DateTime?
  trialEnd           DateTime?
  basePrice          Decimal                       @default(0) @db.Decimal(18, 2)
  usagePrice         Decimal?                      @db.Decimal(18, 2)
  totalPrice         Decimal                       @default(0) @db.Decimal(18, 2)
  currency           String                        @default("SAR")
  quantity           Int                           @default(1)
  addons             Json?
  paymentMethodId    String?
  autoRenew          Boolean                       @default(true)
  cancelAtPeriodEnd  Boolean                       @default(false)
  canceledAt         DateTime?
  cancelReason       String?                       @db.Text
  pausedAt           DateTime?
  resumedAt          DateTime?
  // Company/Team Billing Support
  billingType        String                        @default("individual") // individual, company, team, department
  companySubscriptionId String?                    // Link to parent company subscription
  assignedUserIds    Json?                         // Array of user IDs covered by this subscription
  isCompanyWide      Boolean                       @default(false)
  teamId             String?
  departmentId       String?
  metadata           Json?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  user               User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices           billing_invoices[]
  payments           billing_payments[]
  usageRecords       billing_usage_records[]
  prorations         billing_prorations[]
  revenueRecognition billing_revenue_recognition[]
  employeeInvitations employee_invitations[] @relation("EmployeeInvitations")

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([planId])
  @@index([currentPeriodEnd])
  @@index([billingType])
  @@index([companySubscriptionId])
  @@index([isCompanyWide])
}

model billing_invoices {
  id                 String                        @id @default(uuid())
  invoiceNumber      String                        @unique
  tenantId           String
  userId             String
  subscriptionId     String?
  status             String                        @default("open") // draft, open, paid, void, uncollectible, partially_paid
  type               String                        @default("subscription") // subscription, one_time, usage, credit_memo, debit_memo
  invoiceDate        DateTime                      @default(now())
  dueDate            DateTime
  paidAt             DateTime?
  voidedAt           DateTime?
  subtotal           Decimal                       @default(0) @db.Decimal(18, 2)
  discountAmount     Decimal                       @default(0) @db.Decimal(18, 2)
  taxAmount          Decimal                       @default(0) @db.Decimal(18, 2)
  total              Decimal                       @default(0) @db.Decimal(18, 2)
  amountPaid         Decimal                       @default(0) @db.Decimal(18, 2)
  amountDue          Decimal                       @default(0) @db.Decimal(18, 2)
  currency           String                        @default("SAR")
  lineItems          Json                          @default("[]")
  taxes              Json                          @default("[]")
  discounts          Json?
  credits            Json?
  paymentMethodId    String?
  paymentAttempts    Json?
  metadata           Json?
  pdfUrl             String?                       @db.Text
  emailSent          Boolean                       @default(false)
  emailSentAt        DateTime?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  user               User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription       billing_subscriptions?        @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  payments           billing_payments[]
  prorations         billing_prorations[]
  revenueRecognition billing_revenue_recognition[]
  dunningAttempts    billing_dunning_attempts[]

  @@index([tenantId])
  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
  @@index([invoiceNumber])
  @@index([dueDate])
  @@index([invoiceDate])
}

model billing_payments {
  id                   String                 @id @default(uuid())
  tenantId             String
  userId               String
  invoiceId            String?
  subscriptionId       String?
  amount               Decimal                @db.Decimal(18, 2)
  currency             String                 @default("SAR")
  amountRefunded       Decimal                @default(0) @db.Decimal(18, 2)
  netAmount            Decimal                @db.Decimal(18, 2)
  status               String                 @default("pending") // pending, processing, succeeded, failed, refunded, partially_refunded, disputed
  paymentMethod        String // card, bank_transfer, wallet, mada, apple_pay, google_pay, invoice, cash, check
  paymentMethodId      String?
  paymentMethodDetails Json?
  gateway              String // stripe, paypal, mada, manual
  gatewayTransactionId String?
  gatewayResponse      Json?
  processedAt          DateTime?
  failedAt             DateTime?
  failureReason        String?                @db.Text
  failureCode          String?
  refunds              Json?
  metadata             Json?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice              billing_invoices?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  subscription         billing_subscriptions? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([invoiceId])
  @@index([subscriptionId])
  @@index([status])
  @@index([gateway])
}

model billing_usage_records {
  id                String                 @id @default(uuid())
  tenantId          String
  userId            String
  subscriptionId    String?
  metricType        String // api_calls, storage, compute, etc.
  quantity          Decimal                @db.Decimal(18, 4)
  unit              String
  unitPrice         Decimal                @db.Decimal(18, 4)
  totalPrice        Decimal                @db.Decimal(18, 2)
  currency          String                 @default("SAR")
  periodStart       DateTime
  periodEnd         DateTime
  aggregated        Boolean                @default(false)
  aggregationPeriod String? // daily, monthly, custom
  metadata          Json?
  createdAt         DateTime               @default(now())
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription      billing_subscriptions? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([subscriptionId])
  @@index([metricType])
  @@index([periodStart, periodEnd])
}

model billing_prorations {
  id             String                @id @default(uuid())
  subscriptionId String
  changeType     String // upgrade, downgrade, addon, quantity_change, plan_change
  oldPeriodStart DateTime
  oldPeriodEnd   DateTime
  newPeriodStart DateTime
  newPeriodEnd   DateTime
  oldPrice       Decimal               @db.Decimal(18, 2)
  newPrice       Decimal               @db.Decimal(18, 2)
  proratedDays   Int
  totalDays      Int
  creditAmount   Decimal               @default(0) @db.Decimal(18, 2)
  debitAmount    Decimal               @default(0) @db.Decimal(18, 2)
  netAmount      Decimal               @db.Decimal(18, 2)
  applied        Boolean               @default(false)
  appliedAt      DateTime?
  invoiceId      String?
  creditMemoId   String?
  createdAt      DateTime              @default(now())
  subscription   billing_subscriptions @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  invoice        billing_invoices?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([subscriptionId])
  @@index([applied])
}

model billing_discounts {
  id           String    @id @default(uuid())
  tenantId     String?
  code         String?   @unique
  name         String
  type         String // percentage, fixed_amount, free_trial, volume_discount
  value        Decimal   @db.Decimal(18, 2)
  currency     String?
  applicableTo String    @default("all") // subscription, usage, addon, all
  minAmount    Decimal?  @db.Decimal(18, 2)
  maxAmount    Decimal?  @db.Decimal(18, 2)
