generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shipment {
  id                       String                    @id
  shipmentNumber           String                    @unique
  trackingNumber           String?                   @unique
  referenceNumber          String?
  customerReference        String?
  type                     String
  mode                     String
  status                   String
  priority                 String?
  serviceLevel             String?
  consignorId              String?
  consignorName            String?
  consignorContact         String?
  consigneeId              String?
  consigneeName            String?
  consigneeContact         String?
  notifyPartyName          String?
  customerId               String?
  supplierId               String?
  origin                   Json
  destination              Json
  route                    Json?
  items                    Json
  totalWeight              Decimal                   @db.Decimal(18, 2)
  totalVolume              Decimal                   @db.Decimal(18, 2)
  totalValue               Decimal                   @db.Decimal(18, 2)
  currency                 String                    @default("USD")
  totalPieces              Int?
  totalPallets             Int?
  totalContainers          Int?
  carrierId                String?
  carrierName              String?
  carrierCode              String?
  bookingNumber            String?
  confirmationNumber       String?
  awbNumber                String?
  blNumber                 String?
  houseBL                  String?
  masterBL                 String?
  containerNumber          String?
  vesselName               String?
  vesselIMO                String?
  voyageNumber             String?
  flightNumber             String?
  pickupDate               DateTime?
  estimatedPickup          DateTime?
  actualPickup             DateTime?
  estimatedDelivery        DateTime?
  actualDelivery           DateTime?
  bookingDate              DateTime?
  departureDate            DateTime?
  arrivalDate              DateTime?
  incoterms                String?
  incotermsLocation        String?
  brokerId                 String?
  brokerName               String?
  customs                  Json?
  freightCharges           Json?
  insurance                Json?
  paymentTerms             String?
  paymentMethod            String?
  airFreightDetails        Json?
  seaFreightDetails        Json?
  fclDetails               Json?
  lclDetails               Json?
  roadFreightDetails       Json?
  railFreightDetails       Json?
  bulkDetails              Json?
  projectCargoDetails      Json?
  pricingIntelligence      Json?
  emissions                Json?
  transitTime              Json?
  realTimeTracking         Json?
  aiInsights               Json?
  documents                Json                      @default("[]")
  trackingEvents           Json                      @default("[]")
  exceptions               Json                      @default("[]")
  alerts                   Json                      @default("[]")
  temperatureControl       Json?
  hazmat                   Json?
  specialHandling          Json?
  currentLocation          Json?
  journeyId                String?
  lifecycleId              String?
  rootCauseAnalysisId      String?
  etwId                    String?
  crossBorderRouteId       String?
  blocked                  Boolean                   @default(false)
  blockReason              String?
  blockedAt                DateTime?
  blockedBy                String?
  integrationSource        String?
  externalId               String?
  externalReferences       Json?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  createdBy                String
  updatedBy                String?
  tenantId                 String
  AWBs                     AWB[]
  BillsOfLading            BillOfLading[]
  Containers               Container[]
  CrossBorderRoutes        CrossBorderRoute[]
  HSCodeClassifications    HSCodeClassification[]
  MultimodalSegments       MultimodalSegment[]
  SanctionsScreenings      SanctionsScreening[]
  StateTransitions         StateTransition[]
  VehicleLocationHistories VehicleLocationHistory[]
  BayanWaybills            BayanWaybill[]
  ComplianceCertificates   ComplianceCertificate[]
  LocationRequests         LocationRequest[]
  TruckBanAlerts           TruckBanAlert[]
  GCCComplianceValidations GCCComplianceValidation[]

  @@index([shipmentNumber])
  @@index([trackingNumber])
  @@index([status])
  @@index([mode])
  @@index([tenantId])
  @@index([carrierId])
  @@index([customerId])
  @@index([etwId])
  @@index([createdAt])
}

model AWB {
  id          String   @id
  awbNumber   String   @unique
  type        String
  masterAWB   String?
  shipmentId  String
  airlineCode String
  airlineName String
  shipper     Json
  consignee   Json
  cargo       Json
  handling    Json?
  charges     Json?
  routing     Json?
  status      String
  generatedAt DateTime
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([awbNumber])
  @@index([shipmentId])
  @@index([tenantId])
  @@index([type])
}

model BillOfLading {
  id               String   @id
  blNumber         String   @unique
  type             String
  masterBL         String?
  shipmentId       String
  shippingLineSCAC String
  shippingLineName String
  shipper          Json
  consignee        Json
  notifyParty      Json
  vessel           Json
  containers       Json
  cargo            Json
  freightPayable   String
  placeOfReceipt   String?
  placeOfDelivery  String?
  charges          Json?
  status           String
  generatedAt      DateTime
  tenantId         String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  Shipment         Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([blNumber])
  @@index([shipmentId])
  @@index([tenantId])
}

model Container {
  id              String   @id
  containerNumber String   @unique
  containerType   String
  sealNumber      String?
  shipmentId      String
  isEmpty         Boolean  @default(false)
  vgm             Json?
  stuffing        Json?
  unstuffing      Json?
  status          String
  tenantId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  Shipment        Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  VGMs            VGM[]

  @@index([containerNumber])
  @@index([shipmentId])
  @@index([tenantId])
}

model VGM {
  id                  String     @id
  containerNumber     String
  method              String
  grossMass           Decimal    @db.Decimal(10, 2)
  verifiedBy          String
  verifiedAt          DateTime
  submittedToTerminal Boolean    @default(false)
  submissionReference String?
  certified           Boolean    @default(false)
  containerId         String?
  tenantId            String
  createdAt           DateTime   @default(now())
  Container           Container? @relation(fields: [containerId], references: [id], onDelete: Cascade)

  @@index([containerNumber])
  @@index([tenantId])
}

model CrossBorderRoute {
  id                        String            @id
  shipmentId                String
  originCountry             String
  destinationCountry        String
  transitCountries          Json
  totalCountriesCrossed     Int
  totalBorderCrossings      Int
  estimatedTotalCustomsTime Decimal           @db.Decimal(10, 2)
  complexity                String
  tenantId                  String
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  Shipment                  Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  DutyCalculations          DutyCalculation[]

  @@index([shipmentId])
  @@index([tenantId])
}

model DutyCalculation {
  id                 String            @id
  shipmentId         String
  crossBorderRouteId String?
  country            String
  hsCode             String
  customsValue       Decimal           @db.Decimal(18, 2)
  currency           String
  dutyRate           Decimal           @db.Decimal(5, 2)
  dutyAmount         Decimal           @db.Decimal(18, 2)
  vatGSTRate         Decimal           @db.Decimal(5, 2)
  vatGSTAmount       Decimal           @db.Decimal(18, 2)
  otherTaxes         Json?
  totalDutyTax       Decimal           @db.Decimal(18, 2)
  ftaApplied         Json?
  calculatedAt       DateTime
  tenantId           String
  createdAt          DateTime          @default(now())
  CrossBorderRoute   CrossBorderRoute? @relation(fields: [crossBorderRouteId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([tenantId])
  @@index([country])
  @@index([hsCode])
}

model TrustedTraderCertification {
  id                  String   @id
  companyId           String
  program             String
  certificationNumber String
  country             String
  validFrom           DateTime
  validTo             DateTime
  status              String
  benefits            Json
  tenantId            String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([companyId])
  @@index([program])
  @@index([tenantId])
  @@index([status])
}

model MultimodalSegment {
  id                    String    @id
  segmentId             String
  shipmentId            String
  sequence              Int
  mode                  String
  origin                Json
  destination           Json
  carrier               Json?
  estimatedDeparture    DateTime
  estimatedArrival      DateTime
  actualDeparture       DateTime?
  actualArrival         DateTime?
  distance              Decimal   @db.Decimal(10, 2)
  duration              Decimal   @db.Decimal(10, 2)
  cost                  Decimal   @db.Decimal(18, 2)
  carbonFootprint       Decimal   @db.Decimal(10, 2)
  status                String
  airDetails            Json?
  seaDetails            Json?
  landDetails           Json?
  transshipmentRequired Boolean   @default(false)
  transshipmentPoint    Json?
  transshipmentDuration Decimal?  @db.Decimal(10, 2)
  tenantId              String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  Shipment              Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([tenantId])
  @@index([sequence])
  @@index([mode])
}

model StateTransition {
  id                  String   @id
  shipmentId          String
  fromState           String
  toState             String
  success             Boolean
  errors              Json?
  warnings            Json?
  automationsExecuted Json?
  userId              String
  tenantId            String
  timestamp           DateTime @default(now())
  Shipment            Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([tenantId])
  @@index([timestamp])
}

model SanctionsScreening {
  id               String   @id
  shipmentId       String
  passed           Boolean
  violations       Json?
  screenedEntities Json
  lists            Json
  timestamp        DateTime @default(now())
  tenantId         String
  Shipment         Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([passed])
  @@index([tenantId])
  @@index([timestamp])
}

model HSCodeClassification {
  id                 String    @id
  shipmentId         String?
  itemId             String?
  hsCode             String
  description        String
  confidence         Decimal   @db.Decimal(3, 2)
  chapter            String
  heading            String
  subheading         String
  tariffCode         String
  countrySpecific    Json?
  verified           Boolean   @default(false)
  verificationSource String?
  classifiedBy       String
  tenantId           String
  createdAt          DateTime  @default(now())
  Shipment           Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([hsCode])
  @@index([shipmentId])
  @@index([tenantId])
}

model AccountsPayable {
  id                String   @id
  tenantId          String
  invoiceNumber     String
  vendorName        String
  invoiceDate       DateTime
  dueDate           DateTime
  amount            Decimal  @db.Decimal(18, 2)
  outstandingAmount Decimal  @db.Decimal(18, 2)
  status            String
  sourceModule      String
  sourceInvoiceId   String
  createdAt         DateTime @default(now())
  updatedAt         DateTime

  @@index([dueDate])
  @@index([status])
  @@index([tenantId])
}

model AccountsReceivable {
  id                String   @id
  tenantId          String
  invoiceNumber     String
  customerName      String
  invoiceDate       DateTime
  dueDate           DateTime
  amount            Decimal  @db.Decimal(18, 2)
  outstandingAmount Decimal  @db.Decimal(18, 2)
  status            String
  sourceModule      String
  sourceInvoiceId   String
  createdAt         DateTime @default(now())
  updatedAt         DateTime

  @@index([dueDate])
  @@index([status])
  @@index([tenantId])
}

model Activity {
  id            String    @id
  tenantId      String
  type          String
  subject       String
  description   String?
  relatedToType String
  relatedToId   String
  assignedTo    String?
  dueDate       DateTime?
  completedAt   DateTime?
  status        String
  notes         String?
  metadata      Json?
  createdAt     DateTime  @default(now())
  createdBy     String
  updatedAt     DateTime

  @@index([relatedToType, relatedToId])
  @@index([status])
  @@index([tenantId])
}

model Appointment {
  id                String           @id
  tenantId          String
  dockDoorId        String?
  inboundDeliveryId String?          @unique
  carrier           String
  driverName        String?
  vehiclePlate      String?
  scheduledStart    DateTime
  scheduledEnd      DateTime
  actualStart       DateTime?
  actualEnd         DateTime?
  status            String           @default("SCHEDULED")
  type              String           @default("INBOUND")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime
  DockDoor          DockDoor?        @relation(fields: [dockDoorId], references: [id])
  InboundDelivery   InboundDelivery? @relation(fields: [inboundDeliveryId], references: [id])
  WMSShipment       WMSShipment?

  @@index([scheduledStart])
  @@index([status])
  @@index([tenantId])
}

model Budget {
  id          String       @id
  tenantId    String
  name        String
  description String?
  periodStart DateTime
  periodEnd   DateTime
  totalBudget Decimal      @db.Decimal(18, 2)
  status      String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime
  BudgetItem  BudgetItem[]

  @@index([status])
  @@index([tenantId])
}

model BudgetItem {
  id             String   @id
  budgetId       String
  category       String
  budgetedAmount Decimal  @db.Decimal(18, 2)
  actualAmount   Decimal  @default(0) @db.Decimal(18, 2)
  variance       Decimal  @default(0) @db.Decimal(18, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  Budget         Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
}

model Contact {
  id              String   @id
  tenantId        String
  accountId       String
  firstName       String
  lastName        String
  email           String
  phone           String?
  mobile          String?
  title           String?
  department      String?
  isPrimary       Boolean  @default(false)
  isDecisionMaker Boolean  @default(false)
  employeeId      String?
  notes           String?
  tags            String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime

  @@index([accountId])
  @@index([email])
  @@index([tenantId])
}

model ContentBlockLibrary {
  id         String    @id
  tenantId   String
  title      String
  content    String
  category   String
  tags       String[]
  type       String
  status     String
  version    Int       @default(1)
  usageCount Int       @default(0)
  createdBy  String
  approvedBy String?
  approvedAt DateTime?
  metadata   Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime

  @@index([category])
  @@index([createdBy])
  @@index([status])
  @@index([tenantId])
}

model CopilotAnalytics {
  id              String   @id
  tenantId        String
  userId          String?
  date            DateTime @db.Date
  messagesCount   Int      @default(0)
  tokensUsed      Int      @default(0)
  ragUsed         Int      @default(0)
  memoryUsed      Int      @default(0)
  toolsUsed       Int      @default(0)
  avgResponseTime Int      @default(0)
  avgConfidence   Float    @default(0)
  errorsCount     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime

  @@unique([tenantId, userId, date])
  @@index([date])
  @@index([tenantId])
}

model CopilotConversation {
  id             String           @id
  tenantId       String
  userId         String
  title          String?
  status         String           @default("active")
  moduleId       String?
  featureId      String?
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  CopilotMessage CopilotMessage[]

  @@index([createdAt])
  @@index([status])
  @@index([tenantId, userId])
}

model CopilotMessage {
  id                  String              @id
  conversationId      String
  role                String
  content             String
  metadata            Json?
  timestamp           DateTime            @default(now())
  CopilotConversation CopilotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([timestamp])
}

model CycleCount {
  id             String           @id
  tenantId       String
  reference      String           @unique
  status         String           @default("PLANNED")
  type           String
  description    String?
  scheduledDate  DateTime
  completedDate  DateTime?
  createdBy      String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  CycleCountTask CycleCountTask[]

  @@index([status])
  @@index([tenantId])
}

model CycleCountTask {
  id             String          @id
  cycleCountId   String
  binId          String
  materialId     String?
  expectedQty    Float
  countedQty     Float?
  status         String          @default("PENDING")
  countedBy      String?
  countedAt      DateTime?
  tenantId       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime
  StorageBin     StorageBin      @relation(fields: [binId], references: [id])
  CycleCount     CycleCount      @relation(fields: [cycleCountId], references: [id])
  MaterialMaster MaterialMaster? @relation(fields: [materialId], references: [id])

  @@index([binId])
  @@index([cycleCountId])
}

model DMARCAlert {
  id             String    @id
  tenantId       String
  domain         String
  severity       String
  type           String
  message        String
  details        Json
  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?
  acknowledgedBy String?

  @@index([createdAt])
  @@index([domain])
  @@index([severity])
  @@index([tenantId])
}

model DMARCRecord {
  id           String      @id
  reportId     String
  sourceIp     String
  count        Int
  disposition  String
  dkimResult   String
  spfResult    String
  headerFrom   String
  envelopeFrom String?
  DMARCReport  DMARCReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([sourceIp])
}

model DMARCReport {
  id               String        @id
  tenantId         String
  domain           String
  reportId         String
  organizationName String
  email            String
  dateRangeBegin   DateTime
  dateRangeEnd     DateTime
  policyDomain     String
  policyAdkim      String
  policyAspf       String
  policyP          String
  policySp         String
  policyPct        Int
  createdAt        DateTime      @default(now())
  processedAt      DateTime?
  DMARCRecord      DMARCRecord[]

  @@index([dateRangeBegin, dateRangeEnd])
  @@index([domain])
  @@index([tenantId])
}

model DockDoor {
  id          String        @id
  warehouseId String
  code        String
  type        String
  status      String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  Appointment Appointment[]
  Warehouse   Warehouse     @relation(fields: [warehouseId], references: [id])
}

model DomainReputation {
  id              String   @id
  tenantId        String
  domain          String
  score           Int
  status          String
  dmarcPassRate   Decimal  @db.Decimal(5, 2)
  spfPassRate     Decimal  @db.Decimal(5, 2)
  dkimPassRate    Decimal  @db.Decimal(5, 2)
  spamComplaints  Decimal  @db.Decimal(5, 2)
  bounceRate      Decimal  @db.Decimal(5, 2)
  blacklistStatus String[]
  lastUpdated     DateTime @default(now())

  @@unique([tenantId, domain])
  @@index([domain])
  @@index([tenantId])
}

model ErrorEvent {
  id          String   @id
  eventId     String   @unique
  timestamp   DateTime @default(now())
  level       String
  message     String
  error       Json
  context     Json?
  tags        Json?
  breadcrumbs Json?
  user        Json?
  environment String?
  release     String?
  tenantId    String?

  @@index([eventId])
  @@index([level])
  @@index([tenantId])
  @@index([timestamp])
}

model Event {
  id            String   @id
  aggregateId   String
  aggregateType String
  eventType     String
  version       Int
  payload       Json
  metadata      Json?
  timestamp     DateTime @default(now())
  tenantId      String?

  @@index([aggregateId, aggregateType])
  @@index([eventType])
  @@index([tenantId])
  @@index([timestamp])
}

model ExportHouseBusinessPlan {
  id                 String             @id
  tenantId           String
  licenseId          String
  year               Int
  planData           Json
  documentId         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime
  createdBy          String
  ExportHouseLicense ExportHouseLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, year])
  @@index([licenseId])
  @@index([tenantId])
}

model ExportHouseComplianceRequirement {
  id                 String             @id
  tenantId           String
  licenseId          String
  requirement        String
  description        String
  status             String             @default("pending")
  dueDate            DateTime?
  completedAt        DateTime?
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime
  ExportHouseLicense ExportHouseLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId])
  @@index([status])
  @@index([tenantId])
}

model ExportHouseLicense {
  id                               String                             @id
  tenantId                         String
  applicationNumber                String?                            @unique
  status                           String                             @default("not_applied")
  submittedAt                      DateTime?
  reviewedAt                       DateTime?
  approvedAt                       DateTime?
  expiryDate                       DateTime?
  rejectionReason                  String?
  companyName                      String
  commercialRegister               String
  taxId                            String
  address                          String
  contactPerson                    String
  contactEmail                     String
  contactPhone                     String
  codeOfConductDocumentId          String?
  commercialRegisterDocumentId     String?
  businessPlanDocumentId           String?
  createdAt                        DateTime                           @default(now())
  updatedAt                        DateTime
  createdBy                        String
  ExportHouseBusinessPlan          ExportHouseBusinessPlan[]
  ExportHouseComplianceRequirement ExportHouseComplianceRequirement[]

  @@index([applicationNumber])
  @@index([status])
  @@index([tenantId])
}

model ExternalIntegration {
  id               String             @id
  type             String
  name             String
  description      String?
  status           String             @default("PENDING")
  tenantId         String
  userId           String?
  enabled          Boolean            @default(true)
  config           Json
  metadata         Json?
  lastSyncAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  IntegrationEvent IntegrationEvent[]

  @@index([enabled])
  @@index([status])
  @@index([tenantId])
  @@index([type])
}

model Facility {
  id                  String      @id
  tenantId            String
  name                String
  code                String      @unique
  type                String
  status              String      @default("ACTIVE")
  address             String?
  city                String?
  country             String?
  countryCode         String?
  coordinates         Json?
  regulatoryAuthority String?
  civilDefenseLicense String?
  fireSuppressionType String?
  complianceStatus    String?
  lastInspection      DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime
  metadata            Json?
  Warehouse           Warehouse[]

  @@index([tenantId])
}

model GeneralLedgerEntry {
  id            String   @id
  tenantId      String
  entryNumber   String
  entryDate     DateTime
  description   String
  debitAccount  String
  creditAccount String
  amount        Decimal  @db.Decimal(18, 2)
  status        String
  sourceModule  String?
  sourceId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime

  @@index([entryDate])
  @@index([status])
  @@index([tenantId])
}

model GeofenceDwellTimeTracking {
  id           String       @id
  zoneId       String
  shipmentId   String
  entryTime    DateTime
  exitTime     DateTime?
  dwellTime    Int?
  status       String
  tenantId     String
  GeofenceZone GeofenceZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([status])
  @@index([tenantId])
  @@index([zoneId])
  @@index([zoneId, shipmentId, entryTime])
}

model GeofenceEvent {
  id           String       @id
  zoneId       String
  shipmentId   String?
  vehicleId    String?
  eventType    String
  location     Json
  timestamp    DateTime     @default(now())
  dwellTime    Int?
  metadata     Json?
  tenantId     String
  GeofenceZone GeofenceZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([eventType])
  @@index([shipmentId])
  @@index([tenantId])
  @@index([timestamp])
  @@index([vehicleId])
  @@index([zoneId])
}

model GeofenceKPI {
  id                     String                   @id
  tenantId               String
  name                   String
  description            String?
  formula                String
  target                 Decimal                  @db.Decimal(10, 2)
  unit                   String
  category               String
  calculationMethod      String
