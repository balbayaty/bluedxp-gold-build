# BlueDXP Gold Base — Environment Variables
#
# Copy to .env.local for local dev; set as repo secrets for CI/deploy.
# Anything marked PLACEHOLDER-OK is only needed for module-load (the
# build doesn't call the underlying service, so a fake value works).

# ===== DATABASE (Neon Postgres) =====
# REQUIRED for build (Prisma generate + page-data collection).
DATABASE_URL="postgresql://USER:PASS@HOST.neon.tech/db?sslmode=require"
DIRECT_URL="postgresql://USER:PASS@HOST.neon.tech/db?sslmode=require"
# Forces SSL on raw pg clients that don't read sslmode from the URL.
PGSSLMODE="require"

# ===== REDIS =====
# Build-time: leave empty to use in-memory fallback.
# Production: real redis://host:port URL.
REDIS_URL=""
REDIS_DISABLED="true"

# ===== AUTH (JWT + NextAuth) =====
# At least 32 chars each.
JWT_SECRET="change_me_in_production_at_least_32_chars_long_xx"
NEXTAUTH_SECRET="change_me_in_production_at_least_32_chars_long_xx"
NEXTAUTH_URL="http://localhost:3000"

# ===== EXTERNAL INTEGRATIONS (PLACEHOLDER-OK for build) =====
# These vars are read at module-load time. Routes throw on import if
# they're unset, which fails next build's page-data collection. Real
# values are only needed if the routes are actually called.
ERP_NEXT_URL="https://placeholder.invalid"
ERP_NEXT_API_KEY="build_placeholder_not_real_key"
ERP_NEXT_API_SECRET="build_placeholder_not_real_secret"
BAYAN_QR_SECRET_KEY="build_placeholder_32_char_secret_key_xx"

# ===== TENANT BOOTSTRAP =====
# Many module initializers refuse to run without this in production mode.
BOOTSTRAP_TENANT_ID="default"

# ===== AI PROVIDERS (optional for build) =====
# Real keys only needed for actual AI calls at runtime.
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""

# ===== BUILD HINTS =====
# Skip heavy service init in dev mode (set to 1 to enable full bootstrap).
INIT_SERVICES="0"
