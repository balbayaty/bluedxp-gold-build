# ============================================================================
# CRITICAL: SECRETS & CREDENTIALS (NEVER COMMIT THESE!)
# ============================================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.env
.envrc
secrets/
.secrets/
**/secrets.json
**/credentials.json
**/api-keys.json
**/*secret*
**/*key*.json
**/*password*.json
**/*token*.json
**/config/secrets.*
**/config/credentials.*

# API Keys & Credentials
# NOTE: Avoid overly-broad patterns (e.g. `**/*auth*`) because they can hide legitimate code
# directories like `authorities/` and lead to accidental cleanup or missing files.
# Keep this list focused on known secret file types and locations above.

# Documentation that might contain secrets
FOUND_API_KEYS.md
API_KEYS_AUDIT_REPORT.md
**/*SECRET*.md
**/*KEY*.md
**/*PASSWORD*.md

# ============================================================================
# NODE.JS & DEPENDENCIES
# ============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*
# Lockfiles:
# - We DO commit the lockfile for the package manager we use (npm => package-lock.json).
# - Avoid generating multiple lockfiles at once; if you switch package managers, update this section.
yarn.lock
pnpm-lock.yaml
.npm
.eslintcache

