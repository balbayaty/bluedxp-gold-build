################################################################################
# BlueDXP / Hazalyze - LOCAL ENV TEMPLATE
#
# This file is SAFE to keep in git because it contains NO secrets.
#
# What you do:
# - Copy/rename this file to `.env.local` in the project root
# - Paste your real keys into `.env.local`
#
# Windows PowerShell:
#   Copy-Item env.local.template .env.local
################################################################################

# --- AI (recommended server-side keys) ---
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# --- App ---
NODE_ENV=development
PORT=3002
NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3002
ALLOWED_ORIGINS=http://localhost:3002
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:3002

# --- Data Source Configuration ---
# Set to 'false' to disable demo data fallback (production mode)
# Set to 'true' to allow demo data when services aren't connected (development mode)
ENABLE_DEMO_DATA=true

# --- Security (recommended) ---
JWT_SECRET=change_me_in_production

# Optional JWT validation settings (recommended for real deployments)
# If you use an external Identity Provider, set JWKS + issuer/audience:
# JWT_JWKS_URL=
# JWT_ISSUER=
# JWT_AUDIENCE=

# --- Optional infrastructure (enable as needed) ---
# --- Rabet / WASL credentials (optional; required only if you test those integrations) ---
# RABET_APP_ID=
# RABET_APP_KEY=
# WASL_APP_ID=
# WASL_APP_KEY=
#
# --- Database Configuration ---
# For real data, configure your database connection:
# Option 1: Use DATABASE_URL (recommended)
# DATABASE_URL=postgresql://user:password@localhost:5432/hazalyze
#
# Option 2: Use individual parameters
# USE_DATABASE=true
# DATABASE_TYPE=postgresql
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=hazalyze
# DATABASE_USER=your_user
# DATABASE_PASSWORD=your_password
# DATABASE_SSL=false

# =============================================================================
# STRICT PRODUCTION MODE (Target-2 Bulletproof)
# =============================================================================
# For production deployments, set these (startup will fail if missing):
EVENT_STORE_BACKEND=prisma
#
# Choose ONE:
# JWT_SECRET=
# JWT_JWKS_URL=
# JWT_ISSUER=
# JWT_AUDIENCE=
# ALLOW_HEADER_AUTH_IN_PROD=false
# REDIS_ENABLED=false
# REDIS_URL=redis://localhost:6379
#
# Transportation strict mode (recommended: keep FALSE in production):
ALLOW_TRANSPORT_SIMULATIONS_IN_PROD=false

################################################################################
# PHASE 1: SECURITY & OBSERVABILITY (January 2025)
################################################################################

# Zero-Trust Security
ZERO_TRUST_ENABLED=true
ZERO_TRUST_FAIL_CLOSED=false

# Observability
OBSERVABILITY_ENABLED=true
OTEL_ENABLED=true
OTEL_SERVICE_NAME=bluedxp-platform
JAEGER_ENDPOINT=http://localhost:14268/api/traces
JAEGER_URL=http://localhost:14268/api/traces

# Alerting
SLACK_WEBHOOK_URL=
PAGERDUTY_INTEGRATION_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Vault Integration (for secrets rotation)
VAULT_ENABLED=false
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=

################################################################################
# PHASE 3: SCALABILITY & POLISH (January 2025)
################################################################################

# CDN Configuration (optional)
CDN_PROVIDER=cloudflare
CDN_API_KEY=
CDN_ZONE_ID=
CDN_DISTRIBUTION_ID=

# Database Sharding (optional - JSON array of shards)
# DATABASE_SHARDS=[{"id":"shard-1","host":"localhost","port":5432,"database":"bluedxp","type":"primary","capacity":100,"currentLoad":0,"status":"active"}]

# Redis (for L2 caching)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
